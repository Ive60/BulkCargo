<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🚢 Multi-Cargo Loading Calc"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Format: Name,Weight_tonnes,SF_m3/t (one per line)"
            android:textSize="12sp"
            android:textColor="#666"
            android:layout_marginBottom="12dp" />

        <EditText
            android:id="@+id/inputCargoList"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:hint="Iron Ore,50000,0.55\nCoal,30000,1.20"
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:padding="12dp"
            android:fontFamily="monospace"
            android:scrollbars="vertical" />

        <Button
            android:id="@+id/btnCalculate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Calculate Totals"
            android:textSize="18sp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1565C0"
            android:textColor="#FFFFFF" />

        <TextView
            android:id="@+id/resultText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="#E3F2FD"
            android:textColor="#0D47A1"
            android:textIsSelectable="true"
            android:fontFamily="monospace" />

    </LinearLayout>
</ScrollView>
